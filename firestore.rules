rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kmrsahil9193@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if (isOwner(userId) || isAdmin());
      allow delete: if isOwner(userId) || isAdmin();

      // Subcollections
      match /workout_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /favorites/{exerciseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(exerciseId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /custom_workouts/{workoutId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(workoutId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /avatarConfigurations/{avatarId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(avatarId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(subscriptionId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /meal_plans/{planId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(planId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // Exercises Catalog
    match /exercises/{exerciseId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(exerciseId);
      allow update: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow delete: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
