rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // A real account (Google, Facebook or phone OTP). Guests sign in anonymously
    // and must never read or write personal data.
    function isRealUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isRealUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function isAdmin() {
      return isRealUser() && (
        (request.auth.token.email == 'kmrsahil9193@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User profiles (private: only the owner or an admin)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isRealUser() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId)
        && request.resource.data.userId == userId
        && request.resource.data.keys().size() <= 60;
      allow update: if (isOwner(userId) || isAdmin())
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.keys().size() <= 60;
      allow delete: if isOwner(userId) || isAdmin();

      // Subcollections
      match /workout_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /favorites/{exerciseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(exerciseId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /custom_workouts/{workoutId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(workoutId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /avatarConfigurations/{avatarId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(avatarId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(subscriptionId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /meal_plans/{planId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(planId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // Exercises Catalog (guests may read it for the Explore tab; only admins publish)
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(exerciseId);
      allow update, delete: if isAdmin() || (isRealUser() && resource.data.createdBy == request.auth.uid);
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
